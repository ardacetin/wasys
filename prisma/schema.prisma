generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum DistributionMode {
  NONE
  BALANCED
  RANDOM
}

enum CrmStage {
  LEAD
  CONTACTED
  PROPOSAL
  WON
  LOST
}

enum ChannelType {
  WHATSAPP_QR
  WHATSAPP_CLOUD
  INSTAGRAM
}

enum ChannelStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  ERROR
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Eski Basic/Pro kaldırıldı; tek paket. Faturalama boyutu: maxUsers.
  plan      String   @default("STANDARD")
  maxUsers  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Otomasyon ayarları
  welcomeMessageEnabled Boolean          @default(false)
  welcomeMessage        String?
  awayMessageEnabled    Boolean          @default(false)
  awayMessage           String?
  distributionMode      DistributionMode @default(NONE)
  alertEmail            String?

  users         User[]
  channels      Channel[]
  contacts      Contact[]
  conversations Conversation[]
  tags          Tag[]
  templates     MessageTemplate[]
  quickButtons  QuickButton[]
  assignmentRules AssignmentRule[]
  apiKeys       ApiKey[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           UserRole  @default(AGENT)
  phone          String?
  avatarUrl      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastActiveAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedConversations Conversation[] @relation("AssignedAgent")
  sentMessages          Message[]       @relation("SentBy")
  assignmentRules       AssignmentRule[] @relation("RuleAssignee")
  contactNotes          ContactNote[]   @relation("NoteAuthor")
  accounts              Account[]
  sessions              Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Channel {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           ChannelType
  status         ChannelStatus @default(DISCONNECTED)
  phoneNumber    String?
  sessionId      String?       @unique
  qrData         String?
  metaPhoneId    String?
  metaToken      String?
  metaWabaId     String?
  lastError      String?
  connectedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversations Conversation[]

  @@index([metaPhoneId])
  @@index([organizationId])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String?
  phone          String
  /// WhatsApp chat JID (örn. 905...@s.whatsapp.net veya ...@lid) — gönderimde tercih edilir
  waJid          String?
  email          String?
  avatarUrl      String?
  notes          String?
  company        String?
  crmStage       CrmStage @default(LEAD)
  dealValue      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations Conversation[]
  crmNotes      ContactNote[]

  @@unique([organizationId, phone])
  @@index([organizationId, name])
  @@index([organizationId, crmStage])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId      String
  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedTo     User?    @relation("AssignedAgent", fields: [assignedToId], references: [id])
  subject        String?
  lastMessageAt  DateTime @default(now())
  lastMessagePreview String?
  unreadCount    Int      @default(0)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]
  tags     ConversationTag[]
  intents  IntentSuggestion[]

  @@unique([channelId, contactId])
  @@index([organizationId, lastMessageAt])
  @@index([assignedToId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  status         MessageStatus    @default(SENT)
  body           String?
  mediaUrl       String?
  mediaMimeType  String?
  externalId     String?
  sentById       String?
  sentBy         User?            @relation("SentBy", fields: [sentById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([conversationId, createdAt])
  @@index([externalId])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String   @default("#0F766E")
  createdAt      DateTime @default(now())

  conversations ConversationTag[]

  @@unique([organizationId, name])
}

model ConversationTag {
  conversationId String
  tagId          String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  body           String
  shortcut       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model QuickButton {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  body           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

enum AssignmentMatchType {
  KEYWORD
  TAG
  CHANNEL
  UNASSIGNED
}

model AssignmentRule {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  matchType      AssignmentMatchType
  matchValue     String?
  assignToId     String?
  assignTo       User?               @relation("RuleAssignee", fields: [assignToId], references: [id])
  priority       Int                 @default(100)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, priority])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String
  keyPrefix      String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([keyPrefix])
  @@index([organizationId])
}

model IntentSuggestion {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  intent         String
  confidence     Float    @default(0.5)
  summary        String?
  suggestions    String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

model QuoteRequest {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String
  userCount  Int
  plan       String
  status     String   @default("NEW")
  source     String   @default("LANDING_PAGE")
  createdAt  DateTime @default(now())
  contactedAt DateTime?

  @@index([status, createdAt])
  @@index([email])
}
