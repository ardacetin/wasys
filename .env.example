# Required
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
PLATFORM_ADMIN_EMAILS="admin@example.com"
PLATFORM_ADMIN_PASSWORD="use-a-unique-password-with-at-least-12-characters"

# Optional aliases (Auth.js also accepts these)
# NEXTAUTH_SECRET=...
# NEXTAUTH_URL=...

GATEWAY_URL="http://localhost:4001"
GATEWAY_SECRET="change-me-gateway"
WEBHOOK_BASE_URL="http://localhost:3000"
GATEWAY_PORT="4001"

# Optional: Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=wasys-verify-token

# Production (wasys.pro) example:
# AUTH_URL="https://wasys.pro"
# AUTH_SECRET="<openssl rand -base64 32>"
# DATABASE_URL="file:/absolute/persistent/path/prod.db" # Hostinger'da deploy klasörü dışında
