# Required
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
PLATFORM_ADMIN_EMAILS="admin@example.com"
PLATFORM_ADMIN_PASSWORD="use-a-unique-password-with-at-least-12-characters"

# Optional aliases (Auth.js also accepts these)
# NEXTAUTH_SECRET=...
# NEXTAUTH_URL=...

GATEWAY_URL="http://localhost:4001"
GATEWAY_SECRET="change-me-gateway"
WEBHOOK_BASE_URL="http://localhost:3000"
GATEWAY_PORT="4001"

# Optional: Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=wasys-verify-token

# Optional: Otomatik e-posta (SMTP) — bağlantı kopma uyarıları vb.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Production (wasys.pro) — DB MUST be outside nodejs/ (Redeploy wipes nodejs/):
# WASYS_DATA_DIR=/home/u781807728/wasys-data
# DATABASE_URL=file:/home/u781807728/wasys-data/prod.db
# GATEWAY_DATA_DIR=/home/u781807728/wasys-data
# AUTH_URL="https://wasys.pro"
# AUTH_SECRET="<openssl rand -base64 32>"
